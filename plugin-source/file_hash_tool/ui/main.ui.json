{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        {
          "type": "Card",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 16 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Text",
                      "props": { "text": "文件哈希与属性分析", "style": "titleMedium" }
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "Text",
                      "props": { "text": "选取本地任意文件，计算 MD5、SHA-1、SHA-256 与 CRC32 校验值", "style": "bodySmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 14 } },
                    {
                      "type": "FilledButton",
                      "props": { "text": "选择本地文件", "icon": "folder_open" },
                      "events": {
                        "onPressed": { "action": "callLua", "function": "chooseFile" }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Card",
          "visible": "{{state.hasFile}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Text",
                      "props": { "text": "文件属性", "style": "titleSmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 8 } },
                    {
                      "type": "Text",
                      "props": { "text": "文件名: {{state.fileName}}", "style": "bodyMedium" }
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "Text",
                      "props": { "text": "文件大小: {{state.fileSize}}", "style": "bodyMedium" }
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "Text",
                      "props": { "text": "扩展类型: {{state.fileExt}}", "style": "bodyMedium" }
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "Text",
                      "props": { "text": "修改时间: {{state.fileTime}}", "style": "bodyMedium" }
                    }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Card",
          "visible": "{{state.hasFile}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Text",
                      "props": { "text": "多算法校验值", "style": "titleSmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 10 } },
                    {
                      "type": "Text",
                      "props": { "text": "MD5", "style": "labelLarge" }
                    },
                    { "type": "SizedBox", "props": { "height": 2 } },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.md5Val}}", "style": "bodySmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "OutlinedButton",
                      "props": { "text": "复制 MD5", "icon": "content_copy" },
                      "events": {
                        "onPressed": { "action": "callLua", "function": "copyMd5" }
                      }
                    },
                    { "type": "SizedBox", "props": { "height": 10 } },
                    {
                      "type": "Text",
                      "props": { "text": "SHA-1", "style": "labelLarge" }
                    },
                    { "type": "SizedBox", "props": { "height": 2 } },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.sha1Val}}", "style": "bodySmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "OutlinedButton",
                      "props": { "text": "复制 SHA-1", "icon": "content_copy" },
                      "events": {
                        "onPressed": { "action": "callLua", "function": "copySha1" }
                      }
                    },
                    { "type": "SizedBox", "props": { "height": 10 } },
                    {
                      "type": "Text",
                      "props": { "text": "SHA-256", "style": "labelLarge" }
                    },
                    { "type": "SizedBox", "props": { "height": 2 } },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.sha256Val}}", "style": "bodySmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "OutlinedButton",
                      "props": { "text": "复制 SHA-256", "icon": "content_copy" },
                      "events": {
                        "onPressed": { "action": "callLua", "function": "copySha256" }
                      }
                    },
                    { "type": "SizedBox", "props": { "height": 10 } },
                    {
                      "type": "Text",
                      "props": { "text": "CRC32", "style": "labelLarge" }
                    },
                    { "type": "SizedBox", "props": { "height": 2 } },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.crc32Val}}", "style": "bodySmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "OutlinedButton",
                      "props": { "text": "复制 CRC32", "icon": "content_copy" },
                      "events": {
                        "onPressed": { "action": "callLua", "function": "copyCrc32" }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Card",
          "visible": "{{state.hasFile}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Text",
                      "props": { "text": "哈希比对验证", "style": "titleSmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 8 } },
                    {
                      "type": "TextField",
                      "ref": "compareHashText",
                      "props": {
                        "label": "待比对校验码",
                        "hint": "输入或粘贴需核验的 MD5 / SHA1 / SHA256 / CRC32"
                      }
                    },
                    { "type": "SizedBox", "props": { "height": 10 } },
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "FilledButton",
                              "props": { "text": "核验比对", "icon": "compare_arrows" },
                              "events": {
                                "onPressed": { "action": "callLua", "function": "checkCompare" }
                              }
                            }
                          ]
                        },
                        { "type": "SizedBox", "props": { "width": 8 } },
                        {
                          "type": "OutlinedButton",
                          "props": { "text": "粘贴比对", "icon": "content_copy" },
                          "events": {
                            "onPressed": { "action": "callLua", "function": "pasteAndCompare" }
                          }
                        }
                      ]
                    },
                    { "type": "SizedBox", "props": { "height": 10 } },
                    {
                      "type": "Text",
                      "props": { "text": "{{state.compareResult}}", "style": "bodyMedium" },
                      "visible": "{{state.hasCompareResult}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
