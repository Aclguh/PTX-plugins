{
  "type": "SingleChildScrollView",
  "props": {
    "padding": 16
  },
  "child": {
    "type": "Column",
    "props": {
      "crossAxisAlignment": "stretch"
    },
    "children": [
      {
        "type": "TextField",
        "ref": "inputContent",
        "props": {
          "label": "源数据 (YAML 或 JSON)",
          "hint": "输入或粘贴待转换的配置内容...",
          "maxLines": 7
        },
        "events": {
          "onChanged": {
            "action": "setState",
            "key": "inputContent"
          }
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 10
        }
      },
      {
        "type": "Row",
        "props": {
          "mainAxisAlignment": "spaceBetween"
        },
        "children": [
          {
            "type": "Expanded",
            "child": {
              "type": "FilledButton",
              "props": {
                "text": "YAML 转 JSON",
                "icon": "code"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "yamlToJson"
                }
              }
            }
          },
          {
            "type": "SizedBox",
            "props": {
              "width": 8
            }
          },
          {
            "type": "Expanded",
            "child": {
              "type": "FilledButton",
              "props": {
                "text": "JSON 转 YAML",
                "icon": "compare_arrows"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "jsonToYaml"
                }
              }
            }
          }
        ]
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 8
        }
      },
      {
        "type": "Row",
        "props": {
          "mainAxisAlignment": "spaceBetween"
        },
        "children": [
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "Docker 样例"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "loadSample",
                  "args": ["docker"]
                }
              }
            }
          },
          {
            "type": "SizedBox",
            "props": {
              "width": 8
            }
          },
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "K8s Pod 样例"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "loadSample",
                  "args": ["k8s"]
                }
              }
            }
          }
        ]
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 12
        }
      },
      {
        "type": "Text",
        "props": {
          "text": "{{state.statusMsg}}",
          "style": "bodySmall"
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 12
        }
      },
      {
        "type": "Card",
        "props": {
          "elevation": 1
        },
        "child": {
          "type": "Padding",
          "props": {
            "padding": 12
          },
          "child": {
            "type": "Column",
            "props": {
              "crossAxisAlignment": "stretch"
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "text": "转换结果预览",
                  "style": "titleSmall"
                }
              },
              {
                "type": "SizedBox",
                "props": {
                  "height": 8
                }
              },
              {
                "type": "SelectableText",
                "props": {
                  "text": "{{state.outputContent}}",
                  "style": "bodyMedium"
                }
              }
            ]
          }
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 12
        }
      },
      {
        "type": "FilledButton",
        "props": {
          "text": "复制转换结果",
          "icon": "content_copy"
        },
        "events": {
          "onPressed": {
            "action": "callLua",
            "function": "copyOutput"
          }
        }
      }
    ]
  }
}
