{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        {
          "type": "TextField",
          "ref": "cipherInput",
          "props": {
            "label": "文本",
            "hint": "输入要加解密的内容...",
            "maxLines": 4
          }
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "TextField",
          "ref": "cipherKey",
          "props": {
            "label": "密钥",
            "hint": "维吉尼亚/XOR 使用，凯撒无需密钥"
          }
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "{{state.caesarLbl}}" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "cycleCaesar" }
                  }
                }
              ]
            },
            {
              "type": "IconButton",
              "props": { "icon": "content_copy", "tooltip": "从剪贴板粘贴" },
              "events": {
                "onPressed": { "action": "callLua", "function": "pasteInput" }
              }
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 8 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "凯撒加密" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "caesarEnc" }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "凯撒解密" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "caesarDec" }
                  }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 8 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "维吉尼亚加密" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "vigEnc" }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "维吉尼亚解密" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "vigDec" }
                  }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 8 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "XOR 加密" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "xorEnc" }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "XOR 解密" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "xorDec" }
                  }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Card",
          "visible": "{{state.hasResult}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Row",
                  "children": [
                    {
                      "type": "Expanded",
                      "children": [
                        { "type": "Text", "props": { "text": "处理结果", "style": "titleSmall" } }
                      ]
                    },
                    {
                      "type": "IconButton",
                      "props": { "icon": "content_copy", "tooltip": "复制结果" },
                      "events": {
                        "onPressed": {
                          "action": "copyToClipboard",
                          "text": "{{state.resultText}}"
                        }
                      }
                    }
                  ]
                },
                { "type": "SizedBox", "props": { "height": 6 } },
                {
                  "type": "SelectableText",
                  "props": { "text": "{{state.resultText}}", "style": "bodyMedium" }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Text",
          "props": { "text": "{{state.errorMsg}}", "style": "bodySmall" },
          "visible": "{{state.hasError}}"
        }
      ]
    }
  ]
}
