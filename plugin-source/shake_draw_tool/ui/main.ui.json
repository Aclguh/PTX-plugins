{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        { "type": "Text", "props": { "text": "摇一摇抽签决策箱", "style": "titleMedium" } },
        { "type": "SizedBox", "props": { "height": 4 } },
        { "type": "Text", "props": { "text": "{{state.statusMsg}}", "style": "bodySmall" } },
        { "type": "SizedBox", "props": { "height": 14 } },
        {
          "type": "Card",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 16 },
              "children": [
                {
                  "type": "Row",
                  "children": [
                    {
                      "type": "Expanded",
                      "children": [
                        { "type": "Text", "props": { "text": "抽签决策结果", "style": "bodySmall" } }
                      ]
                    },
                    {
                      "type": "IconButton",
                      "props": { "icon": "content_copy", "tooltip": "复制结果" },
                      "events": { "onPressed": { "action": "callLua", "function": "copyResult" } }
                    }
                  ]
                },
                { "type": "SizedBox", "props": { "height": 8 } },
                {
                  "type": "SelectableText",
                  "props": { "text": "{{state.chosenResult}}", "style": "headlineMedium" }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "随机抽取", "icon": "refresh" },
                  "events": { "onPressed": { "action": "callLua", "function": "drawOption" } }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "感应摇一摇" },
                  "events": { "onPressed": { "action": "callLua", "function": "shakeDetectAndDraw" } }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 14 } },
        { "type": "Text", "props": { "text": "快速切换候选模板", "style": "titleSmall" } },
        { "type": "SizedBox", "props": { "height": 6 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "吃什么" },
                  "events": { "onPressed": { "action": "callLua", "function": "setPresetFood" } }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "聚会惩罚" },
                  "events": { "onPressed": { "action": "callLua", "function": "setPresetParty" } }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "投硬币" },
                  "events": { "onPressed": { "action": "callLua", "function": "setPresetCoin" } }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "TextField",
          "ref": "optionsText",
          "props": {
            "label": "候选选项池 (每行一项)",
            "hint": "输入备选内容，每行一个选项",
            "maxLines": 5
          }
        },
        { "type": "SizedBox", "props": { "height": 14 } },
        {
          "type": "Card",
          "visible": "{{state.hasHistory}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 12 },
              "children": [
                { "type": "Text", "props": { "text": "最近抽取历史", "style": "titleSmall" } },
                { "type": "SizedBox", "props": { "height": 6 } },
                { "type": "SelectableText", "props": { "text": "{{state.historyText}}", "style": "bodySmall" } }
              ]
            }
          ]
        }
      ]
    }
  ]
}
