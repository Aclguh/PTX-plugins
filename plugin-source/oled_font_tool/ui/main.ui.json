{
  "type": "SingleChildScrollView",
  "props": {
    "padding": 16
  },
  "child": {
    "type": "Column",
    "props": {
      "crossAxisAlignment": "stretch"
    },
    "children": [
      {
        "type": "Card",
        "props": {
          "elevation": 2
        },
        "child": {
          "type": "Padding",
          "props": {
            "padding": 16
          },
          "child": {
            "type": "Column",
            "props": {
              "crossAxisAlignment": "center"
            },
            "children": [
              {
                "type": "SelectableText",
                "props": {
                  "text": "{{state.asciiVisual}}",
                  "style": "bodySmall"
                }
              },
              {
                "type": "SizedBox",
                "props": {
                  "height": 8
                }
              },
              {
                "type": "Text",
                "props": {
                  "text": "{{state.byteCountLabel}}",
                  "style": "labelLarge"
                }
              }
            ]
          }
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 16
        }
      },
      {
        "type": "TextField",
        "ref": "inputText",
        "props": {
          "label": "取模字符内容",
          "hint": "如 PTX, 012, 12:30 等"
        },
        "events": {
          "onChanged": {
            "action": "setState",
            "key": "inputText"
          }
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 10
        }
      },
      {
        "type": "Row",
        "props": {
          "mainAxisAlignment": "spaceBetween"
        },
        "children": [
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "{{state.modeDesc}}",
                "icon": "settings"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "toggleMode"
                }
              }
            }
          },
          {
            "type": "SizedBox",
            "props": {
              "width": 8
            }
          },
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "{{state.invertDesc}}",
                "icon": "brush"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "toggleInvert"
                }
              }
            }
          }
        ]
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 10
        }
      },
      {
        "type": "FilledButton",
        "props": {
          "text": "生成 8x8 字模数组",
          "icon": "code"
        },
        "events": {
          "onPressed": {
            "action": "callLua",
            "function": "generateFont"
          }
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 14
        }
      },
      {
        "type": "Card",
        "props": {
          "elevation": 1
        },
        "child": {
          "type": "Padding",
          "props": {
            "padding": 12
          },
          "child": {
            "type": "Column",
            "props": {
              "crossAxisAlignment": "stretch"
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "text": "C 语言代码输出",
                  "style": "titleSmall"
                }
              },
              {
                "type": "SizedBox",
                "props": {
                  "height": 8
                }
              },
              {
                "type": "SelectableText",
                "props": {
                  "text": "{{state.cCodeOutput}}",
                  "style": "bodySmall"
                }
              }
            ]
          }
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 12
        }
      },
      {
        "type": "FilledButton",
        "props": {
          "text": "复制 C 语言字模数组",
          "icon": "content_copy"
        },
        "events": {
          "onPressed": {
            "action": "callLua",
            "function": "copyCode"
          }
        }
      }
    ]
  }
}
