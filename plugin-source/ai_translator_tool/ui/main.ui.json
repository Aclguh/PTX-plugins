{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        { "type": "Text", "props": { "text": "AI 多语言地道翻译对比", "style": "titleMedium" } },
        { "type": "SizedBox", "props": { "height": 4 } },
        { "type": "Text", "props": { "text": "{{state.targetLang}} | {{state.statusMsg}}", "style": "bodySmall" } },
        { "type": "SizedBox", "props": { "height": 14 } },
        { "type": "Text", "props": { "text": "选择目标语言", "style": "titleSmall" } },
        { "type": "SizedBox", "props": { "height": 6 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "英语" },
                  "events": { "onPressed": { "action": "callLua", "function": "setLangEnglish" } }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 6 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "日语" },
                  "events": { "onPressed": { "action": "callLua", "function": "setLangJapanese" } }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 6 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "中文" },
                  "events": { "onPressed": { "action": "callLua", "function": "setLangChinese" } }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 6 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "德语" },
                  "events": { "onPressed": { "action": "callLua", "function": "setLangGerman" } }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "TextField",
          "ref": "inputSource",
          "props": {
            "label": "输入待翻译文本",
            "hint": "输入任意语句、段落、邮件或长文",
            "maxLines": 4
          }
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "FilledButton",
          "props": { "text": "开始深度翻译与对比", "icon": "refresh" },
          "events": { "onPressed": { "action": "callLua", "function": "translateText" } }
        },
        { "type": "SizedBox", "props": { "height": 14 } },
        {
          "type": "Card",
          "visible": "{{state.hasResult}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Row",
                  "children": [
                    {
                      "type": "Expanded",
                      "children": [
                        { "type": "Text", "props": { "text": "3 种风格翻译对照与重点解析", "style": "titleSmall" } }
                      ]
                    },
                    {
                      "type": "IconButton",
                      "props": { "icon": "content_copy", "tooltip": "复制结果" },
                      "events": { "onPressed": { "action": "callLua", "function": "copyResult" } }
                    }
                  ]
                },
                { "type": "SizedBox", "props": { "height": 8 } },
                {
                  "type": "SelectableText",
                  "props": { "text": "{{state.outputResult}}", "style": "bodyMedium" }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
