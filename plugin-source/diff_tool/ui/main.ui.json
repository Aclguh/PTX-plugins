{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        {
          "type": "TextField",
          "ref": "textA",
          "props": { "label": "原文 (A)", "maxLines": 5 }
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "TextField",
          "ref": "textB",
          "props": { "label": "对比文本 (B)", "maxLines": 5 }
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "对比差异", "icon": "search" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "doDiff" }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "OutlinedButton",
              "props": { "text": "交换" },
              "events": {
                "onPressed": { "action": "callLua", "function": "swapTexts" }
              }
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Text",
          "props": { "text": "{{state.statsText}}", "style": "bodySmall" },
          "visible": "{{state.hasResult}}"
        },
        {
          "type": "Text",
          "props": { "text": "{{state.errorMsg}}", "style": "bodySmall" },
          "visible": "{{state.hasError}}"
        },
        { "type": "SizedBox", "props": { "height": 8 } },
        {
          "type": "Card",
          "visible": "{{state.hasResult}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "Text",
                              "props": { "text": "差异明细", "style": "titleSmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "content_copy", "tooltip": "复制差异" },
                          "events": {
                            "onPressed": {
                              "action": "copyToClipboard",
                              "text": "{{state.diffText}}"
                            }
                          }
                        }
                      ]
                    },
                    { "type": "SizedBox", "props": { "height": 6 } },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.diffText}}", "style": "bodySmall" }
                    }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 8 } },
        {
          "type": "Card",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Text",
                  "props": {
                    "text": "标记说明: \"  \" 为两版相同, \"- \" 为 A 独有 (删除), \"+ \" 为 B 独有 (新增)。每侧最多 400 行。",
                    "style": "bodySmall"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
