{
  "type": "SingleChildScrollView",
  "props": {
    "padding": 16
  },
  "children": [
    {
      "type": "Column",
      "props": {
        "crossAxisAlignment": "stretch"
      },
      "children": [
        {
          "type": "Text",
          "props": {
            "text": "电子罗盘与水平仪",
            "style": "titleLarge"
          }
        },
        {
          "type": "SizedBox",
          "props": {
            "height": 4
          }
        },
        {
          "type": "Text",
          "props": {
            "text": "利用地磁与重力加速度传感器，提供方向指引与双轴水平测量",
            "style": "bodySmall"
          }
        },
        {
          "type": "SizedBox",
          "props": {
            "height": 16
          }
        },
        {
          "type": "Card",
          "props": {
            "elevation": 2
          },
          "children": [
            {
              "type": "Padding",
              "props": {
                "padding": 20
              },
              "children": [
                {
                  "type": "Column",
                  "props": {
                    "crossAxisAlignment": "center"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "props": {
                        "text": "罗盘方位角",
                        "style": "labelLarge"
                      }
                    },
                    {
                      "type": "SizedBox",
                      "props": {
                        "height": 8
                      }
                    },
                    {
                      "type": "Text",
                      "props": {
                        "text": "{{state.heading}}°",
                        "style": "displayMedium"
                      }
                    },
                    {
                      "type": "SizedBox",
                      "props": {
                        "height": 4
                      }
                    },
                    {
                      "type": "Text",
                      "props": {
                        "text": "{{state.headingLabel}}",
                        "style": "titleMedium"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "SizedBox",
          "props": {
            "height": 12
          }
        },
        {
          "type": "Card",
          "props": {
            "elevation": 1
          },
          "children": [
            {
              "type": "Padding",
              "props": {
                "padding": 16
              },
              "children": [
                {
                  "type": "Column",
                  "props": {
                    "crossAxisAlignment": "stretch"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "props": {
                        "text": "双轴水平仪状态",
                        "style": "titleSmall"
                      }
                    },
                    {
                      "type": "Divider",
                      "props": {
                        "height": 16
                      }
                    },
                    {
                      "type": "Row",
                      "props": {
                        "mainAxisAlignment": "spaceBetween"
                      },
                      "children": [
                        {
                          "type": "Text",
                          "props": {
                            "text": "俯仰角 (Pitch): {{state.pitch}}°",
                            "style": "bodyMedium"
                          }
                        },
                        {
                          "type": "Text",
                          "props": {
                            "text": "翻滚角 (Roll): {{state.roll}}°",
                            "style": "bodyMedium"
                          }
                        }
                      ]
                    },
                    {
                      "type": "SizedBox",
                      "props": {
                        "height": 10
                      }
                    },
                    {
                      "type": "Text",
                      "props": {
                        "text": "当前水平度: {{state.levelStatus}}",
                        "style": "labelLarge"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "SizedBox",
          "props": {
            "height": 16
          }
        },
        {
          "type": "FilledButton",
          "props": {
            "text": "刷新传感器读数",
            "icon": "refresh"
          },
          "events": {
            "onPressed": {
              "action": "callLua",
              "function": "refreshSensors"
            }
          }
        },
        {
          "type": "SizedBox",
          "props": {
            "height": 16
          }
        },
        {
          "type": "Card",
          "props": {
            "elevation": 0
          },
          "children": [
            {
              "type": "Padding",
              "props": {
                "padding": 14
              },
              "children": [
                {
                  "type": "Column",
                  "props": {
                    "crossAxisAlignment": "stretch"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "props": {
                        "text": "使用提示",
                        "style": "titleSmall"
                      }
                    },
                    {
                      "type": "SizedBox",
                      "props": {
                        "height": 6
                      }
                    },
                    {
                      "type": "Text",
                      "props": {
                        "text": "• 将手机水平平放于被测物表面，双轴角度均在 ±3° 内即视为平整；\n• 罗盘方向请远离强磁场源（大型音箱、金属支架等），避免地磁干扰；\n• 若角度有偏差，可持手机在空中沿“8”字形晃动校准。",
                        "style": "bodySmall"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
