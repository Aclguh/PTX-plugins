{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        {
          "type": "TextField",
          "ref": "jwtInput",
          "props": {
            "label": "JWT 令牌",
            "hint": "粘贴 header.payload.signature 格式的令牌",
            "maxLines": 5
          }
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "解析", "icon": "search" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "parseJwt" }
                  }
                }
              ]
            },
            {
              "type": "IconButton",
              "props": { "icon": "content_copy", "tooltip": "从剪贴板粘贴" },
              "events": {
                "onPressed": { "action": "callLua", "function": "pasteInput" }
              }
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Text",
          "props": { "text": "{{state.errorMsg}}", "style": "bodySmall" },
          "visible": "{{state.hasError}}"
        },
        {
          "type": "Card",
          "visible": "{{state.hasResult}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "Text",
                              "props": { "text": "Header", "style": "titleSmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "content_copy", "tooltip": "复制" },
                          "events": {
                            "onPressed": {
                              "action": "copyToClipboard",
                              "text": "{{state.headerOut}}"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.headerOut}}", "style": "bodySmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 12 } },
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "Text",
                              "props": { "text": "Payload", "style": "titleSmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "content_copy", "tooltip": "复制" },
                          "events": {
                            "onPressed": {
                              "action": "copyToClipboard",
                              "text": "{{state.payloadOut}}"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.payloadOut}}", "style": "bodySmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 12 } },
                    {
                      "type": "Text",
                      "props": { "text": "时间声明", "style": "titleSmall" }
                    },
                    {
                      "type": "Text",
                      "props": { "text": "{{state.claimsOut}}", "style": "bodySmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 6 } },
                    {
                      "type": "Text",
                      "props": { "text": "{{state.sigOut}}", "style": "bodySmall" }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
