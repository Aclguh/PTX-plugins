{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "TextField",
                  "ref": "genCount",
                  "props": { "label": "生成数量 (1-100)" }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 12 } },
            {
              "type": "FilledButton",
              "props": { "text": "生成", "icon": "check" },
              "events": {
                "onPressed": { "action": "callLua", "function": "generate" }
              }
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "标准" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setMode", "args": ["std"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "大写" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setMode", "args": ["upper"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "无连字符" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setMode", "args": ["nodash"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "花括号" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setMode", "args": ["brace"] }
                  }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Card",
          "visible": "{{state.hasResult}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "Text",
                              "props": { "text": "{{state.uuidInfo}}", "style": "titleSmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "content_copy", "tooltip": "复制全部" },
                          "events": {
                            "onPressed": {
                              "action": "copyToClipboard",
                              "text": "{{state.uuidDisplay}}"
                            }
                          }
                        }
                      ]
                    },
                    { "type": "SizedBox", "props": { "height": 6 } },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.uuidDisplay}}", "style": "bodySmall" }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
