{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        {
          "type": "Text",
          "props": {
            "text": "命题逻辑与真值表生成器",
            "style": "titleMedium"
          }
        },
        { "type": "SizedBox", "props": { "height": 6 } },
        {
          "type": "Text",
          "props": {
            "text": "支持 and/or/not/xor、条件式(->)与双条件式(<->)全量真值表演算",
            "style": "bodySmall"
          }
        },
        { "type": "SizedBox", "props": { "height": 16 } },
        {
          "type": "TextField",
          "ref": "logicExpr",
          "props": {
            "label": "逻辑公式表达式",
            "hint": "(p and q) -> r"
          },
          "events": {
            "onChanged": { "action": "setState", "key": "logicExpr" }
          }
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "生成真值表", "icon": "check" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "generate", "args": [] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "OutlinedButton",
              "props": { "text": "清空", "icon": "delete_outline" },
              "events": {
                "onPressed": { "action": "callLua", "function": "clearAll", "args": [] }
              }
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "德·摩根律" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setExample", "args": ["demorgan"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 6 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "假言推理" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setExample", "args": ["modus"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 6 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "逆否命题" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setExample", "args": ["contra"] }
                  }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 16 } },
        {
          "type": "Card",
          "visible": "{{state.hasError}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 12 },
              "children": [
                {
                  "type": "Text",
                  "props": { "text": "错误: {{state.errorMsg}}", "style": "bodyMedium" }
                }
              ]
            }
          ]
        },
        {
          "type": "Card",
          "visible": "{{state.hasResult}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 16 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Text",
                      "props": { "text": "公式定性分析", "style": "titleSmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 6 } },
                    {
                      "type": "Text",
                      "props": {
                        "text": "{{state.formulaClassification}}",
                        "style": "headlineSmall"
                      }
                    },
                    { "type": "SizedBox", "props": { "height": 6 } },
                    {
                      "type": "Text",
                      "props": {
                        "text": "总行数: {{state.totalRows}} | 真值数(T): {{state.trueCount}} | 假值数(F): {{state.falseCount}}",
                        "style": "bodySmall"
                      }
                    },
                    { "type": "SizedBox", "props": { "height": 12 } },
                    {
                      "type": "Text",
                      "props": { "text": "真值表 (Markdown 表格):", "style": "bodySmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 6 } },
                    {
                      "type": "SelectableText",
                      "props": {
                        "text": "{{state.truthTableOutput}}",
                        "style": "bodySmall"
                      }
                    },
                    { "type": "SizedBox", "props": { "height": 14 } },
                    {
                      "type": "OutlinedButton",
                      "props": { "text": "复制真值表", "icon": "content_copy" },
                      "events": {
                        "onPressed": { "action": "callLua", "function": "copyTable", "args": [] }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
