{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        {
          "type": "Text",
          "props": { "text": "提交类型 (Type): {{state.commitType}}", "style": "titleSmall" }
        },
        { "type": "SizedBox", "props": { "height": 6 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "feat" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setType", "args": ["feat"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 4 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "fix" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setType", "args": ["fix"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 4 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "refactor" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setType", "args": ["refactor"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 4 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "docs" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setType", "args": ["docs"] }
                  }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 4 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "chore" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setType", "args": ["chore"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 4 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "perf" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setType", "args": ["perf"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 4 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "test" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setType", "args": ["test"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 4 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "style" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setType", "args": ["style"] }
                  }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "props": { "flex": 1 },
              "children": [
                {
                  "type": "TextField",
                  "ref": "commitScope",
                  "props": {
                    "label": "范围 (Scope, 可选)",
                    "hint": "如 core, auth, ui",
                    "maxLines": 1
                  },
                  "events": {
                    "onChanged": { "action": "setState", "key": "commitScope" }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "props": { "flex": 2 },
              "children": [
                {
                  "type": "TextField",
                  "ref": "commitSubject",
                  "props": {
                    "label": "主题简述 (Subject, 必填)",
                    "hint": "简要描述变更内容",
                    "maxLines": 1
                  },
                  "events": {
                    "onChanged": { "action": "setState", "key": "commitSubject" }
                  }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 8 } },
        {
          "type": "TextField",
          "ref": "commitBody",
          "props": {
            "label": "详细说明 (Body, 可选)",
            "hint": "变更动机与背景细节",
            "maxLines": 3
          },
          "events": {
            "onChanged": { "action": "setState", "key": "commitBody" }
          }
        },
        { "type": "SizedBox", "props": { "height": 8 } },
        {
          "type": "TextField",
          "ref": "commitIssue",
          "props": {
            "label": "关联关闭 Issue (可选)",
            "hint": "例如 Closes #42",
            "maxLines": 1
          },
          "events": {
            "onChanged": { "action": "setState", "key": "commitIssue" }
          }
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "生成提交", "icon": "check" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "generate" }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "OutlinedButton",
              "props": { "text": "破坏性变更(!)", "icon": "swap_vert" },
              "events": {
                "onPressed": { "action": "callLua", "function": "toggleBreaking" }
              }
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Text",
          "props": { "text": "{{state.errorMsg}}", "style": "bodySmall" },
          "visible": "{{state.hasError}}"
        },
        {
          "type": "Card",
          "visible": "{{state.hasResult}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "Text",
                              "props": { "text": "Header: {{state.resHeader}}", "style": "titleSmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "content_copy", "tooltip": "复制提交信息" },
                          "events": {
                            "onPressed": { "action": "callLua", "function": "copyMsg" }
                          }
                        }
                      ]
                    },
                    { "type": "SizedBox", "props": { "height": 8 } },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.resFullMsg}}", "style": "bodyMedium" }
                    },
                    { "type": "SizedBox", "props": { "height": 12 } },
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "Text",
                              "props": { "text": "完整 Shell 命令:", "style": "titleSmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "code", "tooltip": "复制命令" },
                          "events": {
                            "onPressed": { "action": "callLua", "function": "copyCmd" }
                          }
                        }
                      ]
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.resGitCmd}}", "style": "bodySmall" }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
