{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        {
          "type": "Text",
          "props": {
            "text": "Protobuf 二进制逆向解析器",
            "style": "titleMedium"
          }
        },
        { "type": "SizedBox", "props": { "height": 6 } },
        {
          "type": "Text",
          "props": {
            "text": "输入十六进制字节流，自动解析 Varint、Length-delimited 与嵌套 Message 字段",
            "style": "bodySmall"
          }
        },
        { "type": "SizedBox", "props": { "height": 16 } },
        {
          "type": "TextField",
          "ref": "hexInput",
          "props": {
            "label": "十六进制 Hex 字节流",
            "hint": "089601120774657374696e67"
          },
          "events": {
            "onChanged": { "action": "setState", "key": "hexInput" }
          }
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "开始解析", "icon": "check" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "decode", "args": [] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "OutlinedButton",
              "props": { "text": "清空", "icon": "delete_outline" },
              "events": {
                "onPressed": { "action": "callLua", "function": "clearAll", "args": [] }
              }
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "基础载荷" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setSample", "args": ["basic"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 6 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "嵌套对象" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setSample", "args": ["nested"] }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 6 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "定长浮点" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "setSample", "args": ["coords"] }
                  }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 16 } },
        {
          "type": "Card",
          "visible": "{{state.hasError}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 12 },
              "children": [
                {
                  "type": "Text",
                  "props": { "text": "错误: {{state.errorMsg}}", "style": "bodyMedium" }
                }
              ]
            }
          ]
        },
        {
          "type": "Card",
          "visible": "{{state.hasResult}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 16 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Text",
                      "props": { "text": "Protobuf 结构反解", "style": "titleSmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "Text",
                      "props": {
                        "text": "顶层字段数: {{state.fieldCount}} | 总字节: {{state.totalBytes}} B",
                        "style": "bodySmall"
                      }
                    },
                    { "type": "SizedBox", "props": { "height": 12 } },
                    {
                      "type": "SelectableText",
                      "props": {
                        "text": "{{state.outputDisplay}}",
                        "style": "bodyMedium"
                      }
                    },
                    { "type": "SizedBox", "props": { "height": 14 } },
                    {
                      "type": "OutlinedButton",
                      "props": { "text": "复制解析结果", "icon": "content_copy" },
                      "events": {
                        "onPressed": { "action": "callLua", "function": "copyResult", "args": [] }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
