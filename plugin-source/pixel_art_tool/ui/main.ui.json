{
  "type": "SingleChildScrollView",
  "props": {
    "padding": 16
  },
  "child": {
    "type": "Column",
    "props": {
      "crossAxisAlignment": "stretch"
    },
    "children": [
      {
        "type": "Card",
        "props": {
          "elevation": 2
        },
        "child": {
          "type": "Padding",
          "props": {
            "padding": 16
          },
          "child": {
            "type": "Column",
            "props": {
              "crossAxisAlignment": "center"
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "text": "{{state.presetTitle}}",
                  "style": "titleSmall"
                }
              },
              {
                "type": "SizedBox",
                "props": {
                  "height": 10
                }
              },
              {
                "type": "SelectableText",
                "props": {
                  "text": "{{state.asciiVisual}}",
                  "style": "bodyMedium"
                }
              }
            ]
          }
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 16
        }
      },
      {
        "type": "Text",
        "props": {
          "text": "经典 8x8 像素图案库",
          "style": "titleSmall"
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 8
        }
      },
      {
        "type": "Row",
        "props": {
          "mainAxisAlignment": "spaceBetween"
        },
        "children": [
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "爱心"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "loadPreset",
                  "args": ["heart"]
                }
              }
            }
          },
          {
            "type": "SizedBox",
            "props": {
              "width": 6
            }
          },
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "笑脸"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "loadPreset",
                  "args": ["smile"]
                }
              }
            }
          },
          {
            "type": "SizedBox",
            "props": {
              "width": 6
            }
          },
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "小幽灵"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "loadPreset",
                  "args": ["ghost"]
                }
              }
            }
          },
          {
            "type": "SizedBox",
            "props": {
              "width": 6
            }
          },
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "宝剑"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "loadPreset",
                  "args": ["sword"]
                }
              }
            }
          }
        ]
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 12
        }
      },
      {
        "type": "Row",
        "props": {
          "mainAxisAlignment": "spaceBetween"
        },
        "children": [
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "反转色彩",
                "icon": "brush"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "invertArt"
                }
              }
            }
          },
          {
            "type": "SizedBox",
            "props": {
              "width": 8
            }
          },
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "清空画板",
                "icon": "clear"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "clearArt"
                }
              }
            }
          }
        ]
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 16
        }
      },
      {
        "type": "Text",
        "props": {
          "text": "嵌入式 C 语言字模 / 贴图代码",
          "style": "titleSmall"
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 8
        }
      },
      {
        "type": "SelectableText",
        "props": {
          "text": "{{state.cCodeDisplay}}",
          "style": "bodySmall"
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 12
        }
      },
      {
        "type": "Row",
        "props": {
          "mainAxisAlignment": "spaceBetween"
        },
        "children": [
          {
            "type": "Expanded",
            "child": {
              "type": "FilledButton",
              "props": {
                "text": "复制 C 语言数组",
                "icon": "code"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "copyArt",
                  "args": ["c"]
                }
              }
            }
          },
          {
            "type": "SizedBox",
            "props": {
              "width": 8
            }
          },
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "复制字符画",
                "icon": "content_copy"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "copyArt",
                  "args": ["ascii"]
                }
              }
            }
          }
        ]
      }
    ]
  }
}
