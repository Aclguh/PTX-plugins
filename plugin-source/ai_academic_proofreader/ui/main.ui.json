{
  "type": "SingleChildScrollView",
  "props": {
    "padding": 16
  },
  "child": {
    "type": "Column",
    "props": {
      "crossAxisAlignment": "stretch"
    },
    "children": [
      {
        "type": "Text",
        "props": {
          "text": "学术润色语气风格",
          "style": "titleSmall"
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 8
        }
      },
      {
        "type": "Row",
        "props": {
          "mainAxisAlignment": "spaceBetween"
        },
        "children": [
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "严谨学术"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "setTone",
                  "args": ["formal"]
                }
              }
            }
          },
          {
            "type": "SizedBox",
            "props": {
              "width": 6
            }
          },
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "精炼紧凑"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "setTone",
                  "args": ["concise"]
                }
              }
            }
          },
          {
            "type": "SizedBox",
            "props": {
              "width": 6
            }
          },
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "母语流利"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "setTone",
                  "args": ["native"]
                }
              }
            }
          }
        ]
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 8
        }
      },
      {
        "type": "Text",
        "props": {
          "text": "{{state.toneDesc}}",
          "style": "bodySmall"
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 12
        }
      },
      {
        "type": "TextField",
        "ref": "inputPaperText",
        "props": {
          "label": "待润色英文论文段落 / 摘要",
          "hint": "输入英文论文、技术邮件或学术报告草稿...",
          "maxLines": 5
        },
        "events": {
          "onChanged": {
            "action": "setState",
            "key": "inputPaperText"
          }
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 12
        }
      },
      {
        "type": "Row",
        "props": {
          "mainAxisAlignment": "spaceBetween"
        },
        "children": [
          {
            "type": "Expanded",
            "child": {
              "type": "FilledButton",
              "props": {
                "text": "AI 深度学术润色",
                "icon": "brush"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "proofread"
                }
              }
            }
          },
          {
            "type": "SizedBox",
            "props": {
              "width": 8
            }
          },
          {
            "type": "Expanded",
            "child": {
              "type": "OutlinedButton",
              "props": {
                "text": "载入论文样例",
                "icon": "refresh"
              },
              "events": {
                "onPressed": {
                  "action": "callLua",
                  "function": "loadSample"
                }
              }
            }
          }
        ]
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 8
        }
      },
      {
        "type": "Text",
        "props": {
          "text": "{{state.statusText}}",
          "style": "bodySmall"
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 12
        }
      },
      {
        "type": "Card",
        "props": {
          "elevation": 1
        },
        "child": {
          "type": "Padding",
          "props": {
            "padding": 12
          },
          "child": {
            "type": "Column",
            "props": {
              "crossAxisAlignment": "stretch"
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "text": "学术润色文稿与词汇升级建议",
                  "style": "titleSmall"
                }
              },
              {
                "type": "SizedBox",
                "props": {
                  "height": 8
                }
              },
              {
                "type": "SelectableText",
                "props": {
                  "text": "{{state.proofreadOutput}}",
                  "style": "bodySmall"
                }
              }
            ]
          }
        }
      },
      {
        "type": "SizedBox",
        "props": {
          "height": 12
        }
      },
      {
        "type": "FilledButton",
        "props": {
          "text": "复制润色成果",
          "icon": "content_copy"
        },
        "events": {
          "onPressed": {
            "action": "callLua",
            "function": "copyResult"
          }
        }
      }
    ]
  }
}
