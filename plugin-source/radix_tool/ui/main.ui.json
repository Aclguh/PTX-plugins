{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        {
          "type": "TextField",
          "ref": "decInput",
          "props": {
            "label": "十进制整数",
            "hint": "例如 255 或 -42",
            "maxLines": 1
          }
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "FilledButton",
          "props": { "text": "转换为 2/8/16 进制", "icon": "swap_vert" },
          "events": {
            "onPressed": { "action": "callLua", "function": "decToAll" }
          }
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Text",
          "props": { "text": "{{state.errorMsg}}", "style": "bodySmall" },
          "visible": "{{state.hasError}}"
        },
        {
          "type": "Card",
          "visible": "{{state.hasDecResult}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "Text",
                              "props": { "text": "二进制", "style": "titleSmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "content_copy", "tooltip": "复制" },
                          "events": {
                            "onPressed": {
                              "action": "copyToClipboard",
                              "text": "{{state.decBin}}"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.decBin}}", "style": "bodySmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 10 } },
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "Text",
                              "props": { "text": "八进制", "style": "titleSmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "content_copy", "tooltip": "复制" },
                          "events": {
                            "onPressed": {
                              "action": "copyToClipboard",
                              "text": "{{state.decOct}}"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.decOct}}", "style": "bodySmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 10 } },
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "Text",
                              "props": { "text": "十六进制", "style": "titleSmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "content_copy", "tooltip": "复制" },
                          "events": {
                            "onPressed": {
                              "action": "copyToClipboard",
                              "text": "{{state.decHex}}"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.decHex}}", "style": "bodySmall" }
                    }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 18 } },
        {
          "type": "TextField",
          "ref": "srcInput",
          "props": {
            "label": "非十进制数字",
            "hint": "例如 FF1011 或 -1011",
            "maxLines": 1
          }
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "二进制" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "fromBin" }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "八进制" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "fromOct" }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "十六进制" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "fromHex" }
                  }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Card",
          "visible": "{{state.hasSrcResult}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "Text",
                              "props": { "text": "十进制结果", "style": "titleSmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "content_copy", "tooltip": "复制" },
                          "events": {
                            "onPressed": {
                              "action": "copyToClipboard",
                              "text": "{{state.srcDec}}"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "SelectableText",
                      "props": { "text": "{{state.srcDec}}", "style": "bodyLarge" }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
