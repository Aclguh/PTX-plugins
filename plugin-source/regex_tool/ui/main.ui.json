{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "TextField",
                  "ref": "patternStr",
                  "props": { "label": "正则模式", "maxLines": 2 }
                }
              ]
            },
            {
              "type": "IconButton",
              "props": { "icon": "content_copy", "tooltip": "粘贴模式" },
              "events": {
                "onPressed": { "action": "callLua", "function": "pastePattern" }
              }
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 8 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "TextField",
                  "ref": "subjectStr",
                  "props": { "label": "输入文本", "maxLines": 5 }
                }
              ]
            },
            {
              "type": "IconButton",
              "props": { "icon": "content_copy", "tooltip": "粘贴文本" },
              "events": {
                "onPressed": { "action": "callLua", "function": "pasteSubject" }
              }
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "测试匹配", "icon": "search" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "testMatch" }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "查找全部" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "findAll" }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "{{state.caseLabel}}" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "toggleCaseFlag" }
                  }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 8 } },
        {
          "type": "Text",
          "props": { "text": "{{state.errorMsg}}", "style": "bodySmall" },
          "visible": "{{state.hasError}}"
        },
        {
          "type": "Card",
          "visible": "{{state.hasMatch}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "SelectableText",
                  "props": { "text": "{{state.matchResult}}", "style": "bodyMedium" }
                }
              ]
            }
          ]
        },
        {
          "type": "Card",
          "visible": "{{state.hasAll}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Row",
                  "children": [
                    {
                      "type": "Expanded",
                      "children": [
                        {
                          "type": "Text",
                          "props": { "text": "全部匹配", "style": "titleSmall" }
                        }
                      ]
                    },
                    {
                      "type": "IconButton",
                      "props": { "icon": "content_copy", "tooltip": "复制结果" },
                      "events": {
                        "onPressed": {
                          "action": "copyToClipboard",
                          "text": "{{state.allResult}}"
                        }
                      }
                    }
                  ]
                },
                { "type": "SizedBox", "props": { "height": 6 } },
                {
                  "type": "SelectableText",
                  "props": { "text": "{{state.allResult}}", "style": "bodySmall" }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 10 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "TextField",
                  "ref": "replaceStr",
                  "props": { "label": "替换文本 (支持 $1-$9 与 $0)" }
                }
              ]
            },
            {
              "type": "OutlinedButton",
              "props": { "text": "替换预览" },
              "events": {
                "onPressed": { "action": "callLua", "function": "replacePreview" }
              }
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 8 } },
        {
          "type": "Card",
          "visible": "{{state.hasReplace}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "SelectableText",
                  "props": { "text": "{{state.replaceResult}}", "style": "bodyMedium" }
                }
              ]
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 8 } },
        {
          "type": "Card",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Text",
                  "props": {
                    "text": "语法速查: . 任意字符 (换行除外) · * + ? {n,m} 量词 (后随 ? 为懒惰) · [] 字符类与范围 · | 或 · () 捕获组 · (?:) 非捕获 · ^ $ 锚点 · \\d \\w \\s \\b \\B · 标志 i 忽略大小写。模式上限 500 字符, 匹配上限 200 处。",
                    "style": "bodySmall"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
