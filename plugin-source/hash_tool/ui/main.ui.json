{
  "type": "SingleChildScrollView",
  "props": { "padding": 16 },
  "children": [
    {
      "type": "Column",
      "props": { "crossAxisAlignment": "stretch" },
      "children": [
        {
          "type": "TextField",
          "ref": "input",
          "props": {
            "label": "输入内容",
            "hint": "在此输入任意文本...",
            "maxLines": 5
          }
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Row",
          "children": [
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "FilledButton",
                  "props": { "text": "计算哈希", "icon": "check" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "calculate" }
                  }
                }
              ]
            },
            { "type": "SizedBox", "props": { "width": 8 } },
            {
              "type": "Expanded",
              "children": [
                {
                  "type": "OutlinedButton",
                  "props": { "text": "{{state.caseLabel}}" },
                  "events": {
                    "onPressed": { "action": "callLua", "function": "toggleCase" }
                  }
                }
              ]
            },
            {
              "type": "IconButton",
              "props": { "icon": "content_copy", "tooltip": "从剪贴板粘贴" },
              "events": {
                "onPressed": { "action": "callLua", "function": "pasteInput" }
              }
            }
          ]
        },
        { "type": "SizedBox", "props": { "height": 12 } },
        {
          "type": "Card",
          "visible": "{{state.hasResult}}",
          "children": [
            {
              "type": "Padding",
              "props": { "padding": 14 },
              "children": [
                {
                  "type": "Column",
                  "props": { "crossAxisAlignment": "stretch" },
                  "children": [
                    {
                      "type": "Text",
                      "props": { "text": "MD5", "style": "titleSmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "SelectableText",
                              "props": { "text": "{{state.md5Val}}", "style": "bodySmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "content_copy", "tooltip": "复制 MD5" },
                          "events": {
                            "onPressed": {
                              "action": "copyToClipboard",
                              "text": "{{state.md5Val}}"
                            }
                          }
                        }
                      ]
                    },
                    { "type": "SizedBox", "props": { "height": 10 } },
                    {
                      "type": "Text",
                      "props": { "text": "SHA-1", "style": "titleSmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "SelectableText",
                              "props": { "text": "{{state.sha1Val}}", "style": "bodySmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "content_copy", "tooltip": "复制 SHA-1" },
                          "events": {
                            "onPressed": {
                              "action": "copyToClipboard",
                              "text": "{{state.sha1Val}}"
                            }
                          }
                        }
                      ]
                    },
                    { "type": "SizedBox", "props": { "height": 10 } },
                    {
                      "type": "Text",
                      "props": { "text": "SHA-256", "style": "titleSmall" }
                    },
                    { "type": "SizedBox", "props": { "height": 4 } },
                    {
                      "type": "Row",
                      "children": [
                        {
                          "type": "Expanded",
                          "children": [
                            {
                              "type": "SelectableText",
                              "props": { "text": "{{state.sha256Val}}", "style": "bodySmall" }
                            }
                          ]
                        },
                        {
                          "type": "IconButton",
                          "props": { "icon": "content_copy", "tooltip": "复制 SHA-256" },
                          "events": {
                            "onPressed": {
                              "action": "copyToClipboard",
                              "text": "{{state.sha256Val}}"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
